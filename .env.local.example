# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Neon connection string, same database the Hub app uses.
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require

# Hub app base URL (no trailing slash) and the admin_key it expects on
# POST /api/admin/invite. Confirm HUB_ADMIN_KEY matches what's actually set
# in the Hub's own Vercel project env vars (its code falls back to the dev
# default "meridian-admin-dev" if nothing is configured there).
HUB_API_URL=https://meridian-fitness.vercel.app
HUB_ADMIN_KEY=

# Resend API key. The sending domain (meridianstrategy.de) must be verified
# in the Resend dashboard before contact@meridianstrategy.de can send.
RESEND_API_KEY=

# Optional overrides for the invite email content (defaults are in
# api/_invite-email.js if left unset here).
HUB_SIGNUP_URL=https://meridian-fitness.vercel.app/primeiro-acesso
DRIVE_TRAINING_URL=
